# Placeholders only. Never commit real secrets.
#
# Everything below is read by apps/api unless marked otherwise. The API refuses to boot in
# production if any of the production-guarded values is missing or weak - that is
# deliberate, a misconfigured instance should not start rather than start insecurely.

# ---- runtime -------------------------------------------------------------------------
# development | test | production. Defaults to "development", which disables every
# production guard - set it explicitly in any real deployment.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ---- database ------------------------------------------------------------------------
DATABASE_URL=postgresql://kalel:kalel@localhost:5432/kalel
# Containers can apply migrations on boot (idempotent). Read by apps/api only.
RUN_MIGRATIONS=false

# ---- origins -------------------------------------------------------------------------
# APP_BASE_URL is where the CMS is served; API_BASE_URL is the public origin of this API
# and is what media URLs and preview links are built from.
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
# Comma-separated CORS allow-list. Falls back to APP_BASE_URL when empty.
CORS_ORIGINS=

# ---- sessions and auth ---------------------------------------------------------------
# Also signs preview tokens, which are handed to external reviewers by design.
# Production requires at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-string
# Ceiling set at login. The absolute timeout below caps it further.
SESSION_TTL_DAYS=30
# Expires a session that stops being used (minutes). Closes the unattended browser.
SESSION_IDLE_TIMEOUT_MINUTES=720
# Expires a session regardless of use (minutes). Bounds a stolen cookie.
SESSION_ABSOLUTE_TIMEOUT_MINUTES=43200
# How often an active session's token is replaced (minutes).
SESSION_ROTATE_MINUTES=60
# Must be "true" in production; the API refuses to boot otherwise.
COOKIE_SECURE=false

# ---- reverse proxy -------------------------------------------------------------------
# REQUIRED in production. The rate limiter buckets on the client address, so behind a
# proxy with no policy every user shares one bucket and ten failed logins from one host
# answer 429 to everyone.
#
#   direct              no proxy - the socket address is the client address
#   1                   trust exactly one proxy hop (the usual answer)
#   10.0.0.0/8,...      trust these networks
#   loopback            named preset (also linklocal, uniquelocal)
#
# "true" is rejected: it makes the forwarded address client-controlled and therefore
# spoofable per request.
TRUST_PROXY=direct

# ---- observability -------------------------------------------------------------------
# silent | fatal | error | warn | info | debug | trace.
# Defaults per environment (production=info, development=debug, test=silent).
# Production refuses to boot with "silent".
LOG_LEVEL=

# ---- provisioning --------------------------------------------------------------------
# Required only to call POST /v1/bootstrap/init, which creates the first site and its
# owner. Remove it from the environment once the system is provisioned: the route refuses
# after that, but there is no reason to keep a credential that mints full-permission
# accounts. Rate limited to 5 attempts a minute.
BOOTSTRAP_TOKEN=replace-with-a-random-token

# ---- media ---------------------------------------------------------------------------
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_PATH=./uploads
MEDIA_MAX_BYTES=26214400

# ---- API docs ------------------------------------------------------------------------
# Swagger UI at /docs. On by default outside production; opt-in inside it.
ENABLE_DOCS=false

# ---- webhooks ------------------------------------------------------------------------
# Local development only: permits webhooks that target loopback/private addresses.
# Refused at boot when NODE_ENV=production, by both the API and the worker.
ALLOW_PRIVATE_WEBHOOKS=true

# ---- worker (apps/worker) ------------------------------------------------------------
POLL_INTERVAL_MS=1000
# How many outbox events one tick may claim.
OUTBOX_BATCH_SIZE=20
# How many due articles one tick may promote.
SCHEDULER_BATCH_SIZE=100
# How long a tick may run before shutdown stops waiting for it (ms).
SHUTDOWN_GRACE_MS=20000

# ---- CMS (apps/cms) ------------------------------------------------------------------
# Inlined into the browser bundle at BUILD time, not read at runtime. It has to be the
# public API origin, because the browser is what calls it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
